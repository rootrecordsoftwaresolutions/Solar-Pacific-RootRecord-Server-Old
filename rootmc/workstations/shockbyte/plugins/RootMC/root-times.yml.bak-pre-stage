# Root-Times — singular live production (play.rootmc.net / Claims)
# root_playtime: scope=* (global) + scope=<cloud server-id> (per-server)

minecraft-day:
  enabled: true
  timezone: UTC
  length-minutes: 30
  midday-minute: 0
  midnight-minute: 15
  # New world 2026-08-08: local day 0 (persists in mc-day-epoch.txt). /times resetday to re-anchor.
  day-id-base: auto
  world: ''

harvest:
  playtime: true
  activity: true
  flush-interval-seconds: 60
  default-timezone-key: utc_plus_0

playtime:
  server-id: ''
  server-bucket: ''

ip-lookup:
  enabled: true
  url-template: http://ip-api.com/json/{ip}?fields=status,offset,timezone
  cache-hours: 24

afk:
  enabled: true
  after-seconds: 300
  exclude-from-playtime: true
  exclude-from-activity: true
  broadcast: true

welcome:
  enabled: true
  delay-ticks: 40
  line-playtime: '&7Total Playtime: &f{playtime} &7- Your Current Time: &f{time} {timezone}'
  line-mc-day: '&7Minecraft day &f#{worldDay} &7- Ingame time: &f{todTicks} &7({phase})'

web:
  enabled: true
  host: 127.0.0.1
  port: 8767
  token: ''

cloud-status:
  enabled: true
  interval-seconds: 5

tables:
  playtime: playtime
  playtime-monthly: playtime_monthly
  activity-timezone: activity_timezone
  activity-hourly: activity_hourly
  afk-sessions: times_afk_sessions
  times-status: times_status
mysql-status:
  enabled: true
  interval-seconds: 5
