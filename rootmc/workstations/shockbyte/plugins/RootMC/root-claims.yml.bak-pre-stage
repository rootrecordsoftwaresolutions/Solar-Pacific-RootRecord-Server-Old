enabled: true

limits:
  # MVP launch default: generous enough for solo bases, adjustable before 26.3.
  max-claims-per-player: 64
  max-areas-per-player: 3
  max-level-per-area: 10
  require-prior-areas-at-max: true

anchors:
  radius-blocks: 16
  # Expansion anchors must be near the rim; placement always snaps exactly onto that edge.
  edge-tolerance-blocks: 3
  allow-trusted-expansion: true

# Unclaimed wilderness band past the claim edge. Still wilderness (no build protection).
# Strangers cannot claim into this band. Owner + trusted friends are allied: they may claim here,
# skip wilderness destroy fees, and do not trigger satellite alerts.
territory:
  buffer-blocks: 48
  satellite-alerts:
    enabled: true
    cooldown-seconds: 60

# Ava homestead is the public visit spawn (/c spawn Ava_Ivy).
spawn:
  ava-uuid: 78c3de61-0fd6-4800-9eda-cc178eaae34b
  ava-name: Ava_Ivy
  area-name: Ava
  auto-grant: true
  auto-public: true

economy:
  enabled: true
  # First claim costs 75 G: 50 G enters reserve bond flow, 25 G seeds the new Camp/claim bank.
  # area-prices-g[0] is the live first-claim price (overrides first-claim-price-g if both are set).
  first-claim-price-g: 75.0
  first-claim-bank-seed-g: 25.0
  # First expansion costs 10 G from the parent claim bank. Each additional expansion costs 1.1x.
  expansion-base-price-g: 10.0
  expansion-multiplier: 1.1
  # Claim fees are refundable. First-claim refunds return to wallet; expansion refunds return to the parent claim bank.
  unclaim-refund-percent: 100.0
  # Claim fees are tax-free service fees paid to the Server Reserve.
  treasury-channel: service-fee:claim
  area-prices-g:
  - 75.0
  - 1000.0
  - 10000.0
  first-area-bank-seed-g: 25.0
  expansion-prices-g: []

protection:
  protect-containers: true
  protect-doors-buttons-and-redstone: true
  protect-entities: true
  protect-fire: true
  protect-explosions: true
  # Creepers cannot damage claims. Wilderness craters restore after this delay.
  creeper-regeneration:
    enabled: true
    delay-seconds: 30
  protect-pistons: true
  protect-buckets: true

outline:
  enabled: true
  # Per-player toggle via /claim lines. Ground-level outer perimeter of each owner's claim union.
  refresh-ticks: 40
  max-distance-blocks: 160
  points-per-circle: 64
  particle-size: 1.15
  contour-step: 2
  particle-spacing: 1.25

# BlueMap: claim fill + outer territory ring (radius + territory.buffer-blocks).
bluemap:
  enabled: true
  set-label: Claims
  shape-y: 64
  contour-step: 3
  line-width: 2
  fill-alpha: 0.28
  territory-enabled: true
  territory-fill-alpha: 0.12
  territory-line-width: 1

notifications:
  enabled: true

