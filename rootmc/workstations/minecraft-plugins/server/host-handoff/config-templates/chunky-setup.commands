# RootMC chunk pre-generation — ±10k world border (see root-admin.yml world-border.radius).
# plugins/Chunky/config.yml — continue-on-restart: false
#
# Overworld at radius 10000 ≈ 1.6M chunks.
# Monitor: /chunky progress

chunky shape square
chunky center 0 0
chunky radius 10000
chunky world world
chunky start

# Nether (1250 = 10000 / 8):
# chunky radius 1250
# chunky world world_nether
# chunky start

# End:
# chunky radius 10000
# chunky world world_the_end
# chunky start
