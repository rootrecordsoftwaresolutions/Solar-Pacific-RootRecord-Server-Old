lp group default permission set essentials.warp true
lp group default permission set essentials.warps true
lp group default permission set essentials.top true
lp group default permission set rootessentials.top true
# No free heal/feed/repair, portable stations, or combat shortcuts — staff use admin.*
lp group default permission set essentials.feed false
lp group default permission set essentials.heal false
lp group default permission set essentials.repair false
lp group default permission set essentials.more false
lp group default permission set essentials.workbench false
lp group default permission set essentials.extinguish false
lp group default permission set essentials.suicide true
lp group default permission set essentials.disposal true
lp group default permission set essentials.clearinventory true
lp group default permission set essentials.seen true
lp group default permission set rootessentials.mint true
lp group default permission set rootessentials.homes true
lp group default permission set rootessentials.paytoggle true
lp group default permission set rootessentials.baltop true
lp group default permission set rootessentials.reserve true
lp group default permission set rootessentials.survey true

lp group default permission set roothelp.rules true
lp group default permission set roothelp.commands true
lp group default permission set roothelp.discord true
lp group default permission set roothelp.map true
lp group default permission set rootstat.link true
lp group default permission set rootstat.status true
