lp group admin permission set rootadmin.fly.others false
lp group admin permission set rootadmin.gamemode false
lp group admin permission set rootadmin.gamemode.survival true
lp group admin permission set rootadmin.gamemode.spectator true
lp group admin permission set rootadmin.gamemode.creative false
lp group admin permission set rootadmin.gamemode.adventure false
