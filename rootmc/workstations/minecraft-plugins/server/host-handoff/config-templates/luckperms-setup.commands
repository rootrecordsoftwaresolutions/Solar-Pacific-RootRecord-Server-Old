lp group default permission set mcmmo.commands.mcstats true
lp group default permission set mcmmo.commands.mctop true
lp group default permission set mcmmo.commands.inspect true
lp group default permission set mcmmo.commands.party true
lp group default permission set mcmmo.skills.repair true
lp group default permission set mcmmo.skills.salvage true

# ── SUPPORTER / PATRON — lower donor tiers (cosmetic / convenience) ──
lp group supporter permission set essentials.joinmessage true
lp group patron permission set essentials.chat.color true
lp group patron permission set essentials.chat.format true

# ── PRO — monthly donor (billing sync: pro_unlocked → pro) ───────────
lp group pro permission set essentials.chat.color true
lp group pro permission set essentials.chat.format true
lp group pro permission set essentials.nick true
lp group pro permission set essentials.nick.color true
lp group pro permission set essentials.hat true
lp group pro permission set essentials.sethome.multiple.pro true
lp group pro permission set essentials.joinmessage true
lp group pro permission set essentials.signs.use.color true

# ── BENEFACTOR / LIFETIME — top donor tiers ──────────────────────────
lp group benefactor permission set essentials.chat.rgb true
lp group lifetime permission set essentials.sethome.multiple.lifetime true
lp group lifetime permission set essentials.chat.rgb true

# ── MODERATOR — junior staff (inherits helper; admin inherits this) ──
lp group moderator permission set rootadmin.kick true
lp group moderator permission set rootadmin.mute true
lp group moderator permission set rootadmin.unmute true
lp group moderator permission set rootadmin.tempban true
lp group moderator permission set rootadmin.tphere true
lp group moderator permission set rootadmin.vanish true
lp group moderator permission set rootadmin.vanish.see true
lp group moderator permission set rootadmin.socialspy true
lp group moderator permission set rootadmin.reports.notify true
lp group moderator permission set rootadmin.realname true
lp group moderator permission set essentials.kick true
lp group moderator permission set essentials.mute true
lp group moderator permission set essentials.unmute true
lp group moderator permission set essentials.tempban true
lp group moderator permission set essentials.tphere true
lp group moderator permission set essentials.vanish true
lp group moderator permission set essentials.vanish.see true
lp group moderator permission set essentials.socialspy true
lp group moderator permission set essentials.realname true
# Force /tp removed — staff use /tpa like players. Live cleanup if already granted:
# lp group moderator permission unset rootadmin.tp
# lp group moderator permission unset essentials.tp

# ── ADMIN — senior staff (LuckPerms only; never ops.json / never OP) ─
# Economy: eco + baltop only. No give/sudo/world/time/weather/tpall/worldborder/etc.
# Kick/mute/vanish live on moderator — inherited here. No force /tp.
lp group admin permission set rootadmin.ban true
lp group admin permission set rootadmin.unban true
lp group admin permission set rootadmin.tempban.exempt true
lp group admin permission set rootadmin.ban.notify true
lp group admin permission set rootadmin.tpoffline true
