# RootMC LuckPerms setup — paste into server console (one line at a time or //lp bulk)
#
# Ranks (3 tracks + weights for chat prefix):
#   player:  default → wanderer → settler → pioneer → citizen → veteran → elite → champion
#   donor:   default → supporter → patron → pro → benefactor → lifetime → founder
#   staff:   helper → moderator → admin → leadadmin → developer → owner
#
# Billing sync (unchanged): pro_unlocked → pro | life_member → lifetime
# NO "member" group. Staff = LuckPerms only — never ops.json / vanilla OP.
# Run after: LuckPerms MySQL connected, full server restart (no /reload)
# Verify: /lp listgroups

# ── If you already created "member" from an old script, clean up first ──
# lp group pro parent remove member
# lp group member parent remove default
# lp track player remove member
# lp groupdelete member

# ── Create groups ────────────────────────────────────────────────────
lp creategroup wanderer
lp creategroup settler
lp creategroup pioneer
lp creategroup citizen
lp creategroup veteran
lp creategroup elite
lp creategroup champion
lp creategroup supporter
lp creategroup patron
lp creategroup pro
lp creategroup benefactor
lp creategroup lifetime
lp creategroup founder
lp creategroup helper
lp creategroup moderator
lp creategroup admin
lp creategroup leadadmin
lp creategroup developer
lp creategroup owner

# ── Inheritance ──────────────────────────────────────────────────────
lp group wanderer parent add default
lp group settler parent add wanderer
lp group pioneer parent add settler
lp group citizen parent add pioneer
lp group veteran parent add citizen
lp group elite parent add veteran
lp group champion parent add elite

lp group supporter parent add default
lp group patron parent add supporter
lp group pro parent add default
lp group benefactor parent add pro
lp group lifetime parent add benefactor
lp group founder parent add lifetime

lp group helper parent add default
lp group moderator parent add helper
lp group admin parent add moderator
lp group leadadmin parent add admin
lp group developer parent add leadadmin
lp group owner parent add developer

# ── Weights (highest prefix wins in chat) ─────────────────────────────
lp group default setweight 10
lp group wanderer setweight 12
lp group settler setweight 14
lp group pioneer setweight 16
lp group citizen setweight 18
lp group veteran setweight 20
lp group elite setweight 22
lp group champion setweight 24
lp group supporter setweight 35
lp group patron setweight 38
lp group pro setweight 40
lp group benefactor setweight 45
lp group lifetime setweight 50
lp group founder setweight 55
lp group helper setweight 80
lp group moderator setweight 85
lp group admin setweight 100
lp group leadadmin setweight 105
lp group developer setweight 110
lp group owner setweight 120

# ── Display names ────────────────────────────────────────────────────
lp group default setdisplayname Explorer
lp group wanderer setdisplayname Wanderer
lp group settler setdisplayname Settler
lp group pioneer setdisplayname Pioneer
lp group citizen setdisplayname Citizen
lp group veteran setdisplayname Veteran
lp group elite setdisplayname Elite
lp group champion setdisplayname Champion
lp group supporter setdisplayname Supporter
lp group patron setdisplayname Patron
lp group pro setdisplayname Pro
lp group benefactor setdisplayname Benefactor
lp group lifetime setdisplayname Lifetime
lp group founder setdisplayname Founder
lp group helper setdisplayname Helper
lp group moderator setdisplayname Moderator
lp group admin setdisplayname Admin
lp group leadadmin setdisplayname Lead Admin
lp group developer setdisplayname Developer
lp group owner setdisplayname Owner

# ── Chat prefixes (Towny ChatConfig %rootranks_prefix%%rootranks_badge%) ──
# Player track always shows; staff/donor badges append via Root-Ranks PAPI.
lp group default meta setprefix 10 "&8[&7Explorer&8]&r "
lp group wanderer meta setprefix 12 "&8[&7Wanderer&8]&r "
lp group settler meta setprefix 14 "&8[&aSettler&8]&r "
lp group pioneer meta setprefix 16 "&8[&2Pioneer&8]&r "
lp group citizen meta setprefix 18 "&8[&fCitizen&8]&r "
lp group veteran meta setprefix 20 "&8[&8Veteran&8]&r "
lp group elite meta setprefix 22 "&8[&dElite&8]&r "
lp group champion meta setprefix 24 "&8[&5Champion&8]&r "
lp group supporter meta setprefix 35 "&8[&eSupporter&8]&r "
lp group patron meta setprefix 38 "&8[&bPatron&8]&r "
lp group pro meta setprefix 40 "&8[&bPro&8]&r "
lp group benefactor meta setprefix 45 "&8[&6Benefactor&8]&r "
lp group lifetime meta setprefix 50 "&8[&6Lifetime&8]&r "
lp group founder meta setprefix 55 "&8[&c&lFounder&8]&r "
lp group helper meta setprefix 80 "&8[&aHelper&8]&r "
lp group moderator meta setprefix 85 "&8[&9Mod&8]&r "
lp group admin meta setprefix 100 ""
lp group leadadmin meta setprefix 105 "&8[&6Lead Admin&8]&r "
lp group developer meta setprefix 110 "&8[&3Dev&8]&r "
lp group owner meta setprefix 120 "&8[&4Owner&8]&r "

# ── Promotion tracks ─────────────────────────────────────────────────
lp createtrack player
lp track player append default
lp track player append wanderer
lp track player append settler
lp track player append pioneer
lp track player append citizen
lp track player append veteran
lp track player append elite
lp track player append champion

lp createtrack donor
lp track donor append default
lp track donor append supporter
lp track donor append patron
lp track donor append pro
lp track donor append benefactor
lp track donor append lifetime
lp track donor append founder

lp createtrack staff
lp track staff append helper
lp track staff append moderator
lp track staff append admin
lp track staff append leadadmin
lp track staff append developer
lp track staff append owner

# ── DEFAULT — all players ────────────────────────────────────────────
lp group default permission set essentials.spawn true
lp group default permission set essentials.help true
lp group default permission set essentials.list true
lp group default permission set essentials.motd true
lp group default permission set essentials.rules true
