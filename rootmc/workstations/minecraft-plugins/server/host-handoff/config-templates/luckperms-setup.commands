lp group admin permission set essentials.realname true

# ── DEVELOPER / OWNER — inherit admin; creative for dev work ─────────
lp group developer permission set rootadmin.gamemode.creative true
lp group developer permission set essentials.gamemode.creative true
lp group developer permission set rootessentials.gamemode.creative true
lp group owner permission set rootspawn.chamber.bypass true

# ── Assign staff (repeat per person; do NOT add to ops.json) ─────────
# lp user <name> parent add moderator
# lp user <name> parent add admin
# lp user <name> parent add owner

# ── Donor / player ranks (manual or billing sync) ────────────────────
# lp user <name> parent add pro
# lp user <name> parent add lifetime
# lp user <name> promote donor
# lp user <name> promote player
# lp user <name> promote staff

lp sync
