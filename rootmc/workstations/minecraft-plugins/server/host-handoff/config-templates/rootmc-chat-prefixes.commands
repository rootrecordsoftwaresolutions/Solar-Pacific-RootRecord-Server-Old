# RootMC chat rank badges — run on live console after LuckPerms is connected.
# Replaces bare &7 default prefix; pairs with Towny ChatConfig %rootranks_prefix%%rootranks_badge%.
# Full rank ladder lives in luckperms-setup.commands — this file is prefix-only refresh.

lp group default meta setprefix 10 "&8[&7Explorer&8]&r "
lp group wanderer meta setprefix 12 "&8[&7Wanderer&8]&r "
lp group settler meta setprefix 14 "&8[&aSettler&8]&r "
lp group pioneer meta setprefix 16 "&8[&2Pioneer&8]&r "
lp group citizen meta setprefix 18 "&8[&fCitizen&8]&r "
lp group veteran meta setprefix 20 "&8[&8Veteran&8]&r "
lp group elite meta setprefix 22 "&8[&dElite&8]&r "
lp group champion meta setprefix 24 "&8[&5Champion&8]&r "
lp group supporter meta setprefix 35 "&8[&eSupporter&8]&r "
lp group patron meta setprefix 38 "&8[&bPatron&8]&r "
lp group pro meta setprefix 40 "&8[&bPro&8]&r "
lp group benefactor meta setprefix 45 "&8[&6Benefactor&8]&r "
lp group lifetime meta setprefix 50 "&8[&6Lifetime&8]&r "
lp group founder meta setprefix 55 "&8[&c&lFounder&8]&r "
lp group helper meta setprefix 80 "&8[&aHelper&8]&r "
lp group moderator meta setprefix 85 "&8[&9Mod&8]&r "
lp group admin meta setprefix 100 ""
lp group developer meta setprefix 110 "&8[&3Dev&8]&r "
lp group owner meta setprefix 120 "&8[&4Owner&8]&r "
lp sync
