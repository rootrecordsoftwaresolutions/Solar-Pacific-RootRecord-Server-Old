# Expand RootMC to ±10k — Shockbyte console: paste ONE line at a time, press Enter after each.
# Do NOT paste multiple commands on one line.

worldborder center 0 0
worldborder set 20000

chunky pause
chunky world world
chunky shape square
chunky center 0 0
chunky radius 10000
chunky start

# If Chunky says a task is already running, use: chunky continue
# (instead of chunky start) after setting radius.

# Already at radius 5000 and only want the outer ring? Alternative:
# chunky radius +5000
# chunky start

# Nether (10k overworld = 1250 nether blocks) — run as separate lines:
# chunky world world_nether
# chunky radius 1250
# chunky start

# End:
# chunky world world_the_end
# chunky radius 10000
# chunky start

bluemap reload
bluemap update world
