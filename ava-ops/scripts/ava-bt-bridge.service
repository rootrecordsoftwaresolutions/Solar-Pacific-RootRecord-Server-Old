[Unit]
Description=Ava Ops Bluetooth RFCOMM Bridge
After=bluetooth.target network.target
Wants=bluetooth.target
ConditionPathExists=%h/.ollama/skills/state/store/ava-console-up

[Service]
Type=simple
WorkingDirectory=/home/rootrecord/.ollama/skills/origin
ExecStartPre=/usr/bin/bluetoothctl pairable on
ExecStartPre=/usr/bin/bluetoothctl discoverable on
ExecStart=/usr/bin/python3 /home/rootrecord/.ollama/skills/ava-ops/scripts/ava_bt_bridge.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
