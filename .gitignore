# Secrets and live state — never push
.env
.env.*
!.env.example
*.token
*.pem
*.p12
*.jks
*.keystore
credentials.env
credentials.env.*
google-services.json

# Nested site repos keep .git in place (avaivy-cloud/site, etc.)
.git

